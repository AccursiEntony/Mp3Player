<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF121218"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- Copertina album (sinistra, quadrata) -->
    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.42"
        android:scaleType="centerCrop"
        android:src="@drawable/outline_music_note_24"
        android:background="#0D0D14" />

    <!-- Colonna destra -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.58"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:gravity="center_vertical">

        <!-- Titolo -->
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFF8F9FA"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Nessun brano" />

        <!-- Artista -->
        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#9999A8"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/widget_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="2dp"
            android:max="1000"
            android:progress="0"
            android:progressTint="#FF800020"
            android:progressBackgroundTint="#2A2A38" />

        <!-- Tempi -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/widget_time_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:textColor="#55556680"
                android:textSize="9sp"
                android:text="0:00" />
            <TextView
                android:id="@+id/widget_time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:textColor="#55556680"
                android:textSize="9sp"
                android:text="0:00" />
        </RelativeLayout>

        <!-- Riga controlli -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Shuffle -->
            <ImageButton
                android:id="@+id/widget_btn_shuffle"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:src="@drawable/media3_icon_shuffle_off"
                android:background="@android:color/transparent"
                android:tint="#66F8F9FA"
                android:contentDescription="Shuffle" />

            <!-- Precedente -->
            <ImageButton
                android:id="@+id/widget_btn_prev"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:src="@drawable/outline_skip_previous_24"
                android:background="@android:color/transparent"
                android:tint="#FFF8F9FA"
                android:contentDescription="Precedente" />

            <!-- Play/Pausa (cerchio accent) -->
            <ImageButton
                android:id="@+id/widget_btn_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:src="@drawable/outline_play_arrow_24"
                android:background="@drawable/notif_play_button_bg"
                android:tint="#FFF8F9FA"
                android:contentDescription="Play/Pausa" />

            <!-- Successivo -->
            <ImageButton
                android:id="@+id/widget_btn_next"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:src="@drawable/outline_skip_next_24"
                android:background="@android:color/transparent"
                android:tint="#FFF8F9FA"
                android:contentDescription="Successivo" />

            <!-- Repeat -->
            <ImageButton
                android:id="@+id/widget_btn_repeat"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:src="@drawable/media3_icon_repeat_off"
                android:background="@android:color/transparent"
                android:tint="#66F8F9FA"
                android:contentDescription="Repeat" />

        </LinearLayout>
    </LinearLayout>
</LinearLayout>